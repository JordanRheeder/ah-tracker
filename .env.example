# AH Tracker settings. Copy this file to .env (`pnpm run setup` does it) and fill in your values.
# .env is git-ignored and the pre-commit hook refuses to commit it, so keys stay on your machine.

# ---------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------

# Your WoW `_forever_` folder (the one containing Interface/ and WTF/). Price data comes from
# Auctionator full scans saved by the AHTracker addon, imported whenever WoW writes
# WTF/Account/<account>/SavedVariables/AHTracker.lua (on /reload or logout).
# Wine/Linux example: /home/you/Games/battlenet/drive_c/Program Files (x86)/World of Warcraft/_forever_
WOW_FOREVER_DIR=
SCAN_IMPORT_MINUTES=1

# ---------------------------------------------------------------------------------------------
# API keys (all optional; each source switches itself off when its key is blank)
# ---------------------------------------------------------------------------------------------

# Undermine Exchange: hourly prices for every Forever house, plus history backfill.
# Get a key at https://undermine.exchange/api.html
UNDERMINE_API_KEY=

# Blizzard Game Data API: live auction snapshots. Create a client at
# https://develop.battle.net/access/clients and paste its ID and secret.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# TSM public price data needs no key.

# ---------------------------------------------------------------------------------------------
# Houses and sources (defaults are EU PvP Alliance)
# ---------------------------------------------------------------------------------------------

# Blizzard API house (only used if the Blizzard poller is on). Tracked houses are listed in src/config.ts.
BLIZZARD_REGION=eu
BLIZZARD_NAMESPACE=dynamic-forever-eu
BLIZZARD_RULESET_ID=1
AUCTION_HOUSE_ID=110
# true if an auction's buyout is for the whole stack; check with: node src/cli.ts verify-buyout
BLIZZARD_BUYOUT_IS_STACK_TOTAL=true

# TSM public data
TSM_GAME=forever
TSM_REGION=eu
TSM_REALM=pvp-alliance

# Undermine Exchange region; house summaries are checked every UNDERMINE_POLL_MINUTES (they update
# hourly); hourly history is backfilled for items selling at least this many per day across EU.
UNDERMINE_REGION=euf
UNDERMINE_POLL_MINUTES=20
UNDERMINE_BACKFILL_MIN_SOLD_PER_DAY=0

# ---------------------------------------------------------------------------------------------
# Polling, storage and dashboard
# ---------------------------------------------------------------------------------------------

BLIZZARD_POLL_MINUTES=15
TSM_POLL_MINUTES=60
RAW_RETENTION_DAYS=30
DATA_DIR=./data
DASHBOARD_PORT=8787

# ---------------------------------------------------------------------------------------------
# Trading defaults (most can also be changed in the dashboard)
# ---------------------------------------------------------------------------------------------

# AH cut on sales, per house
CUT_ALLIANCE=0.05
CUT_NEUTRAL=0.15
# Minimum margin for shopping-list targets, and the fraction of market value counted as a snipe
LIST_TARGET_MARGIN=0.1
SNIPE_FRACTION=0.5
# Days of history the statistics look back over
STATS_LOOKBACK_DAYS=7
