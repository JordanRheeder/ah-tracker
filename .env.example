# Blizzard API client from https://develop.battle.net/access/clients
# Copy this file to .env and fill these two in yourself.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# WoW: Forever, EU, auction house 110 = PvP Alliance (per forever-prices; verified in phase 1)
BLIZZARD_REGION=eu
BLIZZARD_NAMESPACE=dynamic-forever-eu
BLIZZARD_RULESET_ID=1
AUCTION_HOUSE_ID=110
# true if an auction's buyout is for the whole stack; check with: node src/cli.ts verify-buyout
BLIZZARD_BUYOUT_IS_STACK_TOTAL=true

# TSM public data
TSM_GAME=forever
TSM_REGION=eu
TSM_REALM=pvp-alliance

# Polling and retention
BLIZZARD_POLL_MINUTES=15
TSM_POLL_MINUTES=180
RAW_RETENTION_DAYS=30
DATA_DIR=./data
