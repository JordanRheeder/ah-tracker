{
  "name": "ah-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WoW: Forever auction price tracker for EU PvP Alliance",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "poll": "node src/cli.ts poll-once",
    "start": "node src/cli.ts run",
    "status": "node src/cli.ts status",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "install-addon": "node src/cli.ts install-addon",
    "import-scans": "node src/cli.ts import-scans",
    "dashboard": "node src/api/server.ts",
    "lists": "node src/cli.ts lists",
    "setup": "test -f .env || cp .env.example .env; git config core.hooksPath .githooks; echo \"Now edit .env (at least WOW_FOREVER_DIR)\"",
    "package-addon": "bash scripts/package-addon.sh"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "lightweight-charts": "5.3.0"
  }
}
